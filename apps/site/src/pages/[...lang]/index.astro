---
import Base from "../../layouts/Base.astro";
import TerminalPanel, { type TerminalLine } from "../../components/TerminalPanel.astro";
import { GITHUB_URL, registrySkill, registry } from "../../lib/catalog";
import { langPaths, localized, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

// The session reproduces the CLI's real output lines (packages/cli/src/commands/install.ts and installer.ts).
const demo = registrySkill("mass-code-review") ?? registry.skills[0];
const command = `npx @mass-solutions/skills-cli install ${demo.name} -a claude-code`;
const session: TerminalLine[] = [
  { kind: "prompt", text: command },
  { kind: "output", text: `${demo.name}@${demo.version}: installed to /home/dev/app/.claude/skills/${demo.name}` },
  { kind: "gap" },
  { kind: "comment", text: "# SKILL.md changed on the ref after the registry was generated" },
  { kind: "prompt", text: command },
  { kind: "output", text: `Integrity check failed for ${demo.name}: SKILL.md` },
];
---

<Base lang={lang} title={d.siteName} path="" description={d.tagline}>
  <section class="hero">
    <p class="eyebrow">{d.heroEyebrow}</p>
    <h1 class="display-xl">{d.siteName}</h1>
    <p class="body-lg muted hero-lead">{d.tagline}</p>
    <div class="actions">
      <a class="btn btn-primary" href={localized(lang, "install/")}>{d.install}</a>
      <a class="btn btn-secondary" href={GITHUB_URL}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>{d.nav.github}</a>
    </div>
  </section>

  <div class="hero-visual">
    <TerminalPanel title={d.terminalTitle} caption={d.terminalCaption} lines={session} />
  </div>

  <section class="section" aria-labelledby="what-is-title" data-what-is>
    <div class="page-head">
      <h2 class="display-md" id="what-is-title">{d.whatIsTitle}</h2>
      <p class="body-lg muted">{d.whatIsLead}</p>
    </div>
    <ul class="grid-3 section-tight">
      {
        d.whatIsPoints.map((point) => (
          <li class="card" data-what-is-point>
            <h3 class="card-title">{point.title}</h3>
            <p class="body-sm muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="cta-banner section">
    <p class="headline">{d.nav.catalog}</p>
    <a class="btn btn-primary" href={localized(lang, "catalog/")} data-catalog-cta>{d.nav.catalog} →</a>
  </div>
</Base>
