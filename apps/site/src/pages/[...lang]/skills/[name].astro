---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Snippet from "../../../components/Snippet.astro";
import { REPO } from "@mass-solutions/skills-core";
import { extraFiles, registry, registrySkill, sourceUrl, splitDescription, categoryLabel } from "../../../lib/catalog";
import { langPaths, localized, t, type Lang } from "../../../lib/i18n";

export async function getStaticPaths() {
  const entries = await getCollection("skills");
  const paths = [];
  for (const { params, props } of langPaths()) {
    for (const entry of entries) {
      paths.push({ params: { ...params, name: entry.id }, props: { ...props, entry } });
    }
    for (const [name, deprecation] of Object.entries(registry.deprecated)) {
      paths.push({ params: { ...params, name }, props: { ...props, deprecated: { name, ...deprecation } } });
    }
  }
  return paths;
}

type Entry = Awaited<ReturnType<typeof getCollection<"skills">>>[number];
const { lang, entry, deprecated } = Astro.props as {
  lang: Lang;
  entry?: Entry;
  deprecated?: { name: string; since: string; replacedBy: string[]; reason: string };
};
const d = t(lang);
const name = entry?.id ?? deprecated!.name;
const reg = entry ? registrySkill(entry.id) : undefined;
const parts = entry ? splitDescription(entry.data.description) : undefined;
const Content = entry ? (await render(entry)).Content : undefined;
const extras = reg ? extraFiles(reg) : [];
const meta = entry?.data.metadata ?? {};
const commands = [
  `mass-skills install ${name} -a <agent>`,
  `npx skills add ${REPO} --skill ${name}`,
  `/plugin marketplace add ${REPO}`,
];
---

<Base lang={lang} title={name} path={`skills/${name}/`} description={entry?.data.description}>
  <header class="page-head">
    <p class="eyebrow"><a class="subtle" href={localized(lang)}>{d.nav.catalog}</a>{meta.category && <> / {categoryLabel(meta.category, lang)}</>}</p>
    <h1 class="display-lg">{name}</h1>
    {
      entry && (
        <div class="actions">
          <span class="status-badge">{d.version} {meta.version}</span>
          <span class="status-badge">{d.reviewed} {meta.reviewed}</span>
        </div>
      )
    }
    {parts && <p class="body-lg muted" data-what>{parts.what}</p>}
  </header>

  {
    deprecated && (
      <section class="card card--featured deprecated" data-deprecated>
        <p class="subhead">{d.deprecatedSince(deprecated.since)}</p>
        <p class="muted">
          {d.reason}: {deprecated.reason}
        </p>
        <p class="muted">
          {d.replacedBy}:{" "}
          {deprecated.replacedBy.map((r) => (
            <a href={localized(lang, `skills/${r}/`)}>{r}</a>
          ))}
        </p>
      </section>
    )
  }

  {
    entry && reg && parts && (
      <div class="skill-layout section-tight">
        <div class="skill-main">
          <dl class="grid-2 usage" data-description>
            <div class="card">
              <dt class="eyebrow">{d.useWhen}</dt>
              <dd data-when>{parts.when}</dd>
            </div>
            <div class="card">
              <dt class="eyebrow">{d.doNotUseFor}</dt>
              <dd data-not>{parts.not}</dd>
            </div>
          </dl>

          <section class="panel skill-body" data-skill-body lang="en">
            <h2 class="eyebrow">{d.skillBody}</h2>
            <div class="prose" data-content>{Content && <Content />}</div>
          </section>
        </div>

        <aside class="skill-aside">
          <section class="panel install-panel" data-install>
            <h2 class="aside-title">{d.install}</h2>
            <Snippet label={d.installCli} code={commands[0]} />
            <Snippet label={d.installNpx} code={commands[1]} />
            <Snippet label={d.installMarketplace} code={commands[2]} />
            <p class="body-sm muted">
              <span class="status-badge status-badge--success">sha256</span> {d.hashWarning}
            </p>
          </section>

          <section class="card" data-metadata>
            <h2 class="aside-title">{d.metadata}</h2>
            <dl class="meta-list">
              <dt>{d.author}</dt>
              <dd>{meta.author}</dd>
              <dt>{d.version}</dt>
              <dd>{meta.version}</dd>
              <dt>{d.reviewed}</dt>
              <dd>{meta.reviewed}</dd>
              <dt>{d.category}</dt>
              <dd>{categoryLabel(meta.category, lang)}</dd>
              <dt>{d.tags}</dt>
              <dd>{reg.tags.join(", ")}</dd>
              {meta.requires && (
                <>
                  <dt>{d.requires}</dt>
                  <dd data-requires>{meta.requires}</dd>
                </>
              )}
              {entry.data["allowed-tools"] && (
                <>
                  <dt>{d.allowedTools}</dt>
                  <dd data-allowed-tools>{entry.data["allowed-tools"]}</dd>
                </>
              )}
            </dl>
          </section>

          <section class="card" data-files>
            <h2 class="aside-title">{d.files}</h2>
            <ul class="row-list">
              {reg.files.map((f) => (
                <li class="row" data-file={f.path}>
                  <a class="mono" href={sourceUrl(name, f.path)}>{f.path}</a>
                  <span class="caption subtle">
                    {f.bytes} {d.bytes}
                  </span>
                </li>
              ))}
            </ul>
            {extras.length > 0 && (
              <div data-extra-files>
                <h3 class="eyebrow">{d.extraFiles}</h3>
                <ul class="row-list">
                  {extras.map((g) => (
                    <li class="row">
                      <code>{g.folder}/</code>
                      <span class="caption subtle">{g.files.length}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <p class="caption subtle hash">
              {d.contentHash}: <code data-content-hash>{reg.contentHash}</code>
            </p>
            <a class="btn btn-secondary" data-source href={sourceUrl(name)}>
              {d.source}
            </a>
          </section>
        </aside>
      </div>
    )
  }
</Base>
