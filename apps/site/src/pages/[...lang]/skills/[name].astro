---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Snippet from "../../../components/Snippet.astro";
import { REPO } from "@mass-solutions/skills-core";
import {
  categoryLabel,
  fileAnchor,
  maintainerFiles,
  registry,
  registrySkill,
  skillFiles,
  sourceUrl,
  splitDescription,
  splitSkillRefs,
  type SkillFile,
} from "../../../lib/catalog";
import { absLocalized, langPaths, localized, t, type Lang } from "../../../lib/i18n";
import { CATALOG_REF, allowlistFor, refUrl, scanDate, scanStatus, validatorErrors } from "../../../lib/security";

export async function getStaticPaths() {
  const entries = await getCollection("skills");
  const paths = [];
  for (const { params, props } of langPaths()) {
    for (const entry of entries) {
      paths.push({ params: { ...params, name: entry.id }, props: { ...props, entry } });
    }
    for (const [name, deprecation] of Object.entries(registry.deprecated)) {
      paths.push({ params: { ...params, name }, props: { ...props, deprecated: { name, ...deprecation } } });
    }
  }
  return paths;
}

type Entry = Awaited<ReturnType<typeof getCollection<"skills">>>[number];
const { lang, entry, deprecated } = Astro.props as {
  lang: Lang;
  entry?: Entry;
  deprecated?: { name: string; since: string; replacedBy: string[]; reason: string };
};
const d = t(lang);
const name = entry?.id ?? deprecated!.name;
const reg = entry ? registrySkill(entry.id) : undefined;
const parts = entry ? splitDescription(entry.data.description) : undefined;
const Content = entry ? (await render(entry)).Content : undefined;
const meta = entry?.data.metadata ?? {};
// Verification badges: what this build checked for the skill, each linking to its explanation on /security.
const errors = entry ? validatorErrors(name) : [];
const accepted = entry ? allowlistFor(name) : [];
const scanLabel = !scanStatus
  ? d.badgeScanNone
  : scanStatus.result === "passed"
    ? d.badgeScanPassed(scanDate(scanStatus))
    : scanStatus.result === "failed"
      ? d.badgeScanFailed(scanDate(scanStatus))
      : d.badgeScanSkipped(scanDate(scanStatus), scanStatus.reason);

// Shipped files in registry order, grouped by top-level folder ("." for the root) for the tree; Markdown
// ones render through the `skillFiles` collection, the rest as plain code blocks.
const files: SkillFile[] = reg ? skillFiles(reg) : [];
const skillMd = files.find((f) => f.path === "SKILL.md");
const folderTokens = files.reduce((sum, f) => sum + f.tokens, 0);
const tree: Array<{ folder: string; files: SkillFile[] }> = [];
for (const f of files) {
  const folder = f.path.includes("/") ? f.path.split("/")[0] : ".";
  const group = tree.find((g) => g.folder === folder);
  if (group) group.files.push(f);
  else tree.push({ folder, files: [f] });
}
const bundled = files.filter((f) => f.path !== "SKILL.md");
const rendered = new Map<string, Awaited<ReturnType<typeof render>>["Content"]>();
for (const f of bundled.filter((f) => f.markdown)) {
  const fileEntry = await getEntry("skillFiles", `${name}/${f.path}`);
  if (fileEntry) rendered.set(f.path, (await render(fileEntry)).Content);
}
const extras = reg ? maintainerFiles(reg) : [];
const num = new Intl.NumberFormat(lang === "en" ? "en-US" : "pt-BR");
const commands = [
  `npx @mass-solutions/skills-cli install ${name} -a <agent>`,
  `npx skills add ${REPO} --skill ${name}`,
  `/plugin marketplace add ${REPO}`,
];

// JSON-LD for skill pages
const skillUrl = absLocalized(lang, `skills/${name}/`);
const skillJsonLd: unknown[] | undefined =
  entry && reg
    ? [
        {
          "@context": "https://schema.org",
          "@type": "SoftwareSourceCode",
          "@id": `${skillUrl}#skill`,
          name,
          description: entry.data.description,
          url: skillUrl,
          codeRepository: sourceUrl(name),
          version: meta.version,
          license: "https://creativecommons.org/licenses/by/4.0/",
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: d.siteName, item: absLocalized(lang, "") },
            { "@type": "ListItem", position: 2, name: d.nav.catalog, item: absLocalized(lang, "catalog/") },
            { "@type": "ListItem", position: 3, name, item: skillUrl },
          ],
        },
      ]
    : undefined;
---

<Base lang={lang} title={name} path={`skills/${name}/`} description={entry?.data.description} jsonLd={skillJsonLd}>
  <header class="page-head">
    <p class="eyebrow"><a class="subtle" href={localized(lang, "catalog/")}>{d.nav.catalog}</a>{meta.category && <> / <a class="subtle" href={localized(lang, `catalog/${meta.category}/`)} data-category-link={meta.category}>{categoryLabel(meta.category, lang)}</a></>}</p>
    <h1 class="display-lg">{name}</h1>
    {
      entry && (
        <div class="actions">
          <span class="status-badge">{d.version} {meta.version}</span>
          <span class="status-badge">{d.reviewed} {meta.reviewed}</span>
        </div>
      )
    }
    {
      entry && reg && (
        <ul class="actions badges" data-verification aria-label={d.verification}>
          <li>
            <a class:list={["status-badge", { "status-badge--success": errors.length === 0 }]} href={localized(lang, "security/#validator")} data-badge="validator" data-state={errors.length === 0 ? "passed" : "failed"}>
              {errors.length === 0 ? d.badgeValidatorPassed : d.badgeValidatorErrors(errors.length)}
            </a>
          </li>
          <li>
            <a class:list={["status-badge", { "status-badge--success": scanStatus?.result === "passed" }]} href={localized(lang, "security/#scan")} data-badge="scan" data-state={scanStatus?.result ?? "none"}>
              {scanLabel}
            </a>
          </li>
          <li>
            <a class="status-badge status-badge--success" href={localized(lang, "security/#integrity")} data-badge="hash" data-state="recorded">
              {d.badgeHash}
            </a>
          </li>
          {accepted.length > 0 && (
            <li>
              <a class="status-badge" href={localized(lang, "security/#allowlist")} data-badge="allowlist" data-state={String(accepted.length)}>
                {d.badgeAllowlist(accepted.length)}
              </a>
            </li>
          )}
          <li>
            <a class="status-badge" href={refUrl(name)} data-badge="ref" data-state={CATALOG_REF}>
              {d.badgeRef(CATALOG_REF)}
            </a>
          </li>
        </ul>
      )
    }
    {
      accepted.length > 0 && (
        <ul class="allowlist-notes" data-allowlist>
          {accepted.map((e) => (
            <li class="caption subtle" data-allowlist-entry={e.risk}>
              <code>{e.risk}</code> · {d.allowlistReason}: {e.reason} · {d.allowlistExpires} <time datetime={e.expiresAt}>{e.expiresAt}</time>
            </li>
          ))}
        </ul>
      )
    }
    {
      skillMd && (
        <p class="actions tokens" data-tokens title={d.tokensNote}>
          <span class="status-badge" data-tokens-skill={skillMd.tokens}>
            {d.tokensSkill} ≈ {num.format(skillMd.tokens)} {d.tokens}
          </span>
          {bundled.length > 0 && (
            <span class="status-badge" data-tokens-folder={folderTokens}>
              {d.tokensFolder} ≈ {num.format(folderTokens)} {d.tokens}
            </span>
          )}
        </p>
      )
    }
    {parts && <p class="body-lg muted" data-what>{parts.what}</p>}
  </header>

  {
    deprecated && (
      <section class="card card--featured deprecated" data-deprecated>
        <p class="subhead">{d.deprecatedSince(deprecated.since)}</p>
        <p class="muted">
          {d.reason}: {deprecated.reason}
        </p>
        <p class="muted">
          {d.replacedBy}:{" "}
          {deprecated.replacedBy.map((r) => (
            <a href={localized(lang, `skills/${r}/`)}>{r}</a>
          ))}
        </p>
      </section>
    )
  }

  {
    entry && reg && parts && (
      <div class="skill-layout section-tight">
        <div class="skill-main">
          <dl class="grid-2 usage" data-description>
            <div class="card">
              <dt class="eyebrow">{d.useWhen}</dt>
              <dd data-when>{parts.when}</dd>
            </div>
            <div class="card">
              <dt class="eyebrow">{d.doNotUseFor}</dt>
              <dd data-not>
                {splitSkillRefs(parts.not).map((seg) =>
                  seg.skill ? (
                    <a data-related href={localized(lang, `skills/${seg.skill}/`)}>
                      {seg.text}
                    </a>
                  ) : (
                    seg.text
                  ),
                )}
              </dd>
            </div>
          </dl>

          <section class="panel skill-body" id="skill-body" data-skill-body lang="en">
            <h2 class="eyebrow">{d.skillBody}</h2>
            <div class="prose" data-content>{Content && <Content />}</div>
          </section>

          {bundled.length > 0 && (
            <section class="panel skill-body" data-file-contents lang="en">
              <h2 class="eyebrow">{d.bundledFiles}</h2>
              <p class="body-sm muted">{d.bundledFilesIntro} {d.tokensNote}</p>
              {bundled.map((f) => {
                const Rendered = rendered.get(f.path);
                return (
                  <details class="file-block" id={fileAnchor(f.path)} data-file-content={f.path}>
                    <summary>
                      <code class="file-path">{f.path}</code>
                      <span class="caption subtle">
                        {num.format(f.bytes)} {d.bytes} · ≈ {num.format(f.tokens)} {d.tokens}
                      </span>
                    </summary>
                    <p class="caption subtle file-meta">
                      sha256 <code>{f.sha256}</code> · <a href={sourceUrl(name, f.path)}>{d.openOnGithub}</a>
                    </p>
                    <div class="prose">{Rendered ? <Rendered /> : <pre><code>{f.text}</code></pre>}</div>
                  </details>
                );
              })}
            </section>
          )}
        </div>

        <aside class="skill-aside">
          <section class="panel install-panel" data-install>
            <h2 class="aside-title">{d.install}</h2>
            <Snippet label={d.installCli} code={commands[0]} />
            <Snippet label={d.installNpx} code={commands[1]} />
            <Snippet label={d.installMarketplace} code={commands[2]} />
            <p class="body-sm muted">
              <span class="status-badge status-badge--success">sha256</span> {d.hashWarning}
            </p>
          </section>

          <section class="card" data-metadata>
            <h2 class="aside-title">{d.metadata}</h2>
            <dl class="meta-list">
              <dt>{d.author}</dt>
              <dd>{meta.author}</dd>
              <dt>{d.version}</dt>
              <dd>{meta.version}</dd>
              <dt>{d.reviewed}</dt>
              <dd>{meta.reviewed}</dd>
              <dt>{d.category}</dt>
              <dd><a href={localized(lang, `catalog/${meta.category}/`)}>{categoryLabel(meta.category, lang)}</a></dd>
              <dt>{d.tags}</dt>
              <dd>{reg.tags.join(", ")}</dd>
              {meta.requires && (
                <>
                  <dt>{d.requires}</dt>
                  <dd data-requires>{meta.requires}</dd>
                </>
              )}
              {entry.data["allowed-tools"] && (
                <>
                  <dt>{d.allowedTools}</dt>
                  <dd data-allowed-tools>{entry.data["allowed-tools"]}</dd>
                </>
              )}
            </dl>
          </section>

          <section class="card" data-files>
            <h2 class="aside-title">{d.files}</h2>
            <ul class="row-list file-tree">
              {tree.map((g) => (
                <>
                  {g.folder !== "." && (
                    <li class="row file-folder" data-folder={g.folder}>
                      <code>{g.folder}/</code>
                      <span class="caption subtle">{g.files.length}</span>
                    </li>
                  )}
                  {g.files.map((f) => (
                    <li class:list={["row", { "file-nested": g.folder !== "." }]} data-file={f.path} title={`sha256 ${f.sha256}`}>
                      <a class="mono" href={f.path === "SKILL.md" ? "#skill-body" : `#${fileAnchor(f.path)}`}>
                        {f.path === "SKILL.md" ? f.path : f.path.slice(g.folder.length + 1)}
                      </a>
                      <span class="caption subtle">
                        {f.bytes} {d.bytes} · ≈ {num.format(f.tokens)} {d.tokens}
                      </span>
                    </li>
                  ))}
                </>
              ))}
            </ul>
            {bundled.length > 0 && (
              <p class="caption subtle" data-extra-files>
                {d.extraFiles}: {tree.filter((g) => g.folder !== ".").map((g) => `${g.folder}/`).join(", ")}
              </p>
            )}
            {extras.length > 0 && (
              <div data-maintainer-files>
                <h3 class="eyebrow">{d.maintainerFiles}</h3>
                <ul class="row-list">
                  {extras.map((f) => (
                    <li class="row">
                      <a class="mono" href={sourceUrl(name, f.path)}>{f.path}</a>
                      <span class="caption subtle">
                        {f.bytes} {d.bytes}
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="caption subtle">{d.maintainerFilesNote}</p>
              </div>
            )}
            <p class="caption subtle hash">
              {d.contentHash}: <code data-content-hash>{reg.contentHash}</code>
            </p>
            <a class="btn btn-secondary" data-source href={sourceUrl(name)}>
              {d.source}
            </a>
          </section>
        </aside>
      </div>
    )
  }
</Base>
