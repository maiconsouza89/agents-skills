---
import Base from "../../layouts/Base.astro";
import Snippet from "../../components/Snippet.astro";
import { AGENTS } from "@mass-solutions/skills-cli/agents";
import { langPaths, localized, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---

<Base lang={lang} title={d.agentsTitle} path="agents/">
  <header class="page-head">
    <p class="eyebrow">mass-skills install -a</p>
    <h1 class="display-lg">{d.agentsTitle}</h1>
    <p class="body-lg muted">{d.agentsIntro}</p>
  </header>
  <div class="panel table-panel section-tight">
    <table data-agents>
      <thead>
        <tr>
          <th scope="col">{d.agentId}</th>
          <th scope="col">{d.projectPath}</th>
          <th scope="col">{d.globalPath}</th>
        </tr>
      </thead>
      <tbody>
        {
          AGENTS.map((a) => (
            <tr data-agent={a.id}>
              <td><a href={localized(lang, `agents/${a.id}/`)}><code>{a.id}</code></a></td>
              <td><code>{a.projectDir}/</code></td>
              <td><code>~/{a.globalDir}/</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="section-tight">
    <Snippet code="npx @mass-solutions/skills-cli install <skill> -a auto" />
  </div>
</Base>
