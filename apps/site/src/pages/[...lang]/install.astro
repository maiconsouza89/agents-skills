---
import Base from "../../layouts/Base.astro";
import Snippet from "../../components/Snippet.astro";
import { REPO } from "@mass-solutions/skills-core";
import { langPaths, localized, t, type Lang } from "../../lib/i18n";

export function getStaticPaths() {
  return langPaths();
}

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const commands = [
  `mass-skills install <skill> -a <agent>`,
  `npx skills add ${REPO} --skill <skill>`,
  `/plugin marketplace add ${REPO}\n/plugin install mass-solutions-skills@mass-solutions`,
];
---

<Base lang={lang} title={d.installTitle} path="install/">
  <header class="page-head">
    <p class="eyebrow">{d.siteName}</p>
    <h1 class="display-lg">{d.installTitle}</h1>
    <p class="body-lg muted">{d.installIntro}</p>
  </header>
  <ol class="grid-3 section-tight" data-install-paths>
    {
      d.installPaths.map((p, i) => (
        <li class:list={["card", "install-path", { "card--featured": i === 0 }]}>
          <div class="install-path-head">
            <h2 class="card-title">{p.title}</h2>
            {i === 0 && <span class="status-badge status-badge--success">sha256</span>}
          </div>
          <Snippet code={commands[i]} />
          <p class="body-sm subtle">{p.verifies}</p>
        </li>
      ))
    }
  </ol>
  <div class="cta-banner section">
    <p class="headline">{d.hashWarning}</p>
    <a class="btn btn-secondary" href={localized(lang, "agents/")}>{d.nav.agents} →</a>
  </div>
</Base>
