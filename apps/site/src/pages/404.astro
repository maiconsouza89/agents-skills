---
import Base from "../layouts/Base.astro";
import { href, t } from "../lib/i18n";

const en = t("en");
const pt = t("pt-br");
---

<Base lang="en" title={en.notFound} path="">
  <h1>404</h1>
  <p>{en.notFoundBody} / {pt.notFoundBody}</p>
  <ul class="rows">
    <li><span class="marker">[+]</span><a href={href("")}>{en.backToCatalog}</a></li>
    <li><span class="marker">[+]</span><a href={href("pt-br/")}>{pt.backToCatalog}</a></li>
  </ul>
</Base>
