---
import { Font } from "astro:assets";
import "../styles/global.css";
import { LANG_META, LANGS, absLocalized, localized, otherLang, t, type Lang } from "../lib/i18n";
import { GITHUB_URL } from "../lib/catalog";

interface Props {
  lang: Lang;
  title: string;
  /** Path of this page without locale prefix, e.g. `""`, `"install/"`, `"skills/mass-x/"`. */
  path: string;
  description?: string;
  /** Additional JSON-LD objects beyond the always-present WebSite node. */
  jsonLd?: unknown[];
}

const { lang, title, path, description, jsonLd } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
const links = [
  { href: localized(lang, "catalog/"), label: d.nav.catalog, current: path === "catalog/" },
  { href: localized(lang, "install/"), label: d.nav.install, current: path === "install/" },
  { href: localized(lang, "agents/"), label: d.nav.agents, current: path === "agents/" },
  { href: localized(lang, "security/"), label: d.nav.security, current: path === "security/" },
  { href: localized(lang, "about/"), label: d.nav.about, current: path === "about/" },
];

// Absolute URLs for SEO
const canonicalUrl = absLocalized(lang, path);
const enUrl = absLocalized("en", path);
const ptUrl = absLocalized("pt-br", path);
const homeUrl = absLocalized("en", "");
const ogTitle = `${title} · ${d.siteName}`;
const ogDescription = description ?? d.tagline;

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${homeUrl}#website`,
  name: d.siteName,
  description: d.tagline,
  url: homeUrl,
  inLanguage: ["en", "pt-BR"],
};
const allJsonLd = [websiteJsonLd, ...(jsonLd ?? [])];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#010102" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <title>{title} · {d.siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content={d.siteName} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(allJsonLd)} />
  </head>
  <body>
    <a class="skip-link btn btn-secondary" href="#main">{d.skipToContent}</a>
    <header class="top-nav">
      <div class="container top-nav-inner">
        <a class="wordmark" href={localized(lang)}><span class="brand-mark" aria-hidden="true"></span>{d.siteName}</a>
        <nav class="nav-links" aria-label="main">
          {links.map((l) => <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
        </nav>
        <div class="nav-end">
          <details class="lang-menu" name="top-nav" data-lang-switch>
            <summary class="btn btn-tertiary"><span class="sr-only">{d.language}: </span>{LANG_META[lang].code}<svg class="chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg></summary>
            <ul class="lang-menu-panel">
              {LANGS.map((l) => (
                <li>
                  <a href={localized(l, path)} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}><span class="lang-code">{LANG_META[l].code}</span> {LANG_META[l].name}</a>
                </li>
              ))}
            </ul>
          </details>
          <div class="nav-actions">
            <a class="btn btn-secondary nav-github" href={GITHUB_URL}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>{d.nav.github}</a>
            <a class="btn btn-primary" href={localized(lang, "install/")}>{d.install}</a>
          </div>
          <details class="nav-menu" name="top-nav">
            <summary class="btn btn-secondary">{d.menu}</summary>
            <nav class="nav-menu-panel" aria-label="mobile">
              {links.map((l) => <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
              <a class="nav-github" href={GITHUB_URL}><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>{d.nav.github}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="wordmark" href={localized(lang)}><span class="brand-mark" aria-hidden="true"></span>{d.siteName}</a>
          <p>{d.tagline}</p>
        </div>
        <div>
          <p class="footer-title">{d.footerSite}</p>
          <ul>
            {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-title">{d.footerProject}</p>
          <ul>
            <li><a href={GITHUB_URL}>{d.nav.github}</a></li>
            <li><a href={`${GITHUB_URL}/blob/main/SECURITY.md`}>{d.footerSecurity}</a></li>
            <li><a href={`${GITHUB_URL}/blob/main/CONTRIBUTING.md`}>{d.footerContributing}</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-title">{d.language}</p>
          <ul>
            {LANGS.map((l) => <li><a href={localized(l)} hreflang={l}>{LANG_META[l].name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="container">
        <p class="footer-legal">{d.footer}</p>
      </div>
    </footer>
    <script is:inline>
      // Copy-to-clipboard for [data-copy] buttons (Snippet, TerminalPanel) and .prose pre blocks.
      (function () {
        var ICON_COPY = '<svg class="icon-copy" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
        var ICON_CHECK = '<svg class="icon-check" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

        function doCopy(text, btn) {
          var label = btn.getAttribute('aria-label');
          function onSuccess() {
            btn.classList.add('copy-btn--copied');
            btn.setAttribute('aria-label', 'Copied!');
            setTimeout(function () {
              btn.classList.remove('copy-btn--copied');
              btn.setAttribute('aria-label', label);
            }, 2000);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(onSuccess).catch(function () {});
          } else {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.cssText = 'position:fixed;opacity:0;pointer-events:none';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); onSuccess(); } catch (e) {}
            document.body.removeChild(ta);
          }
        }

        function init() {
          // Bind [data-copy] buttons already in the HTML (Snippet, TerminalPanel).
          document.querySelectorAll('[data-copy]:not([data-copy-bound])').forEach(function (btn) {
            btn.setAttribute('data-copy-bound', '1');
            btn.addEventListener('click', function () { doCopy(btn.getAttribute('data-copy'), btn); });
          });
          // Add copy buttons to .prose pre blocks rendered from SKILL.md.
          document.querySelectorAll('.prose pre:not([data-copy-bound])').forEach(function (pre) {
            pre.setAttribute('data-copy-bound', '1');
            pre.style.position = 'relative';
            var btn = document.createElement('button');
            btn.className = 'copy-btn prose-copy-btn';
            btn.type = 'button';
            btn.setAttribute('aria-label', 'Copy to clipboard');
            btn.innerHTML = ICON_COPY + ICON_CHECK;
            btn.addEventListener('click', function () {
              var code = pre.querySelector('code');
              doCopy(code ? code.textContent : pre.textContent, btn);
            });
            pre.appendChild(btn);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </body>
</html>
