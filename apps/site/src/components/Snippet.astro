---
interface Props {
  label?: string;
  code: string;
}

const { label, code } = Astro.props;
// Long commands wrap at spaces, but a flag (-a, --skill) or a placeholder (<agent>) never splits across lines.
const keep = (word: string) => word.startsWith("-") || word.startsWith("<");
---

<div class="snippet-block">
  {label && <p class="caption subtle">{label}</p>}
  <code class="snippet">{code.split("\n").map((line, i) => <>{i > 0 && "\n"}{line.split(" ").map((w, j) => <>{j > 0 && " "}{keep(w) ? <span class="nowrap">{w}</span> : w}</>)}</>)}</code>
</div>
